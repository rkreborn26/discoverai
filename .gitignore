# Virtual Environment
venv/
env/
ENV/
.venv

# Environment variables - broad net on purpose, not just the exact
# names above. Catches any .env variant anywhere in the repo (backend/,
# a nested folder, a future one) - e.g. backend/.env.bak_test, which
# wasn't covered by the older, narrower patterns below and slipped
# through. If a real .env.example template is ever added for onboarding,
# add "!.env.example" after this block to un-ignore just that one file.
**/.env
**/.env.*
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

