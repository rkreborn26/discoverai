!data/processed/.gitkeep
!data/raw/.gitkeep

# Seed data CSVs (produced by EXPORT_SEED_DATA.py) - regenerable from a
# live database, and products.csv alone runs ~192MB (OpenAI embeddings
# stored as text), well past GitHub's 100MB hard file-size limit. The
# scripts that generate/load this are source; the CSVs themselves aren't.
seed_data/

# Claude's own working notes from earlier sessions - not project content.
memory/

# Personal resume/portfolio page - unrelated to the DiscoverAI codebase,
# doesn't belong bundled inside this project's repo.
portfolio/

# Personal learning-notes doc with a real Windows username baked into
# its example paths - stays local, not part of the public portfolio repo.
discoverai-learning-guide.html